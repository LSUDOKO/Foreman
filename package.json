{
  "name": "foreman",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev:all": "bun scripts/dev-all.ts",
    "e2e": "bun scripts/e2e.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pay-test": "bun scripts/pay-test.ts",
    "serv-test": "bun scripts/serv-test.ts",
    "call-test": "bun scripts/call-test.ts",
    "record": "bash scripts/record-screens.sh",
    "recordings": "bun scripts/fetch-recordings.ts",
    "reset": "bun scripts/reset.ts",
    "mcp": "bun services/mcp/src/stdio.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "hono": "^4.13.0",
    "solc": "0.8.38",
    "typescript": "^7.0.2",
    "viem": "^2.57.0",
    "zod": "^4.6.0"
  },
  "dependencies": {
    "@foreman/shared": "workspace:*"
  }
}
