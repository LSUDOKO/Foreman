# Copy to .env, or run `bun run setup` which writes the wallets and defaults for you.
# Anything left blank runs against the local sandbox (labelled SIM everywhere). Fill a section to go live.

# ---------- SERV Reasoning (required by the hackathon) ----------
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_TURN_TIMEOUT_MS=4000

# ---------- Kite ----------
KITE_NETWORK=testnet                 # testnet = chain 2368 / pieUSD · mainnet = 2366 / USDC.e
PAYMENTS_MODE=sim                    # sim = local signature-checking facilitator · live = Pieverse facilitator, real settlement
FACILITATOR_URL=https://facilitator.pieverse.io/v2
# KITE_RPC / KITE_EXPLORER override the defaults in packages/shared/src/kite.ts

BUSINESS_PK=
BUSINESS_ADDRESS=
FOREMAN_PK=
FOREMAN_ADDRESS=
FOREMAN_PAYTO=
ORACLE_SIGNER_PK=
ORACLE_SIGNER_ADDRESS=
CLEARCALL_PAYTO=
QUICKDIAL_PAYTO=
ORACLE_PAYTO=

# ---------- Prices (USD, settled in pieUSD) ----------
CLEARCALL_PRICE=0.50
QUICKDIAL_PRICE=0.30
BONUS_PRICE=0.20
ORACLE_PRICE=0.02
INVOICE_CONFIRMED=4.00
INVOICE_ATTENDED=2.00
BUSINESS_MAX_PER_OUTCOME=6.00

# ---------- Twilio (blank = sandbox carrier) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_API_KEY_SID=                  # the oracle reads call records with its own key
TWILIO_API_KEY_SECRET=
CLEARCALL_PUBLIC_URL=                # https://xxxx.trycloudflare.com → :4110
QUICKDIAL_PUBLIC_URL=                # → :4111
WORKER_HMAC_SECRET=

# ---------- Cal.com (blank = sandbox calendar) ----------
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=1
CALCOM_READ_KEY=

# ---------- Email (blank = sandbox inbox) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FOREMAN_PUBLIC_URL=                  # https://yyyy.trycloudflare.com → :4000 (links in confirmation emails)

# ---------- App ----------
BUSINESS_NAME=Smile Dental
BUSINESS_TZ=Asia/Kolkata
CONSOLE_TOKEN=
DB_PATH=.data/foreman.sqlite
